{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@steps/*": ["./tests/steps/*"],
      "@pages/*": ["./tests/pages/*"],
      "@api/*": ["./tests/api/*"],
      "@utils/*": ["./tests/utils/*"]
    }
  },
  "include": ["tests/**/*.ts", "playwright.config.ts"]
}
